#!/bin/sh

version_number="5.1.5"

# UI

# shellcheck disable=SC2086
# $1 = prompt, $2 = multi select flag (for fzf/rofi), $3 = extra flags by user
menu() {
    case "$menu_program" in
        fzf) fzf_menu "$@" ;;
        rofi) rofi -sort -dmenu -i -p "$1" $2 $3 ;;
        dmenu) dmenu -l 20 -p "$1" $3 ;;
        *) "$menu_program" $3 "$1" ;;
    esac
}

# input lines are (value \t label [\t hidden fields]) and only the label is shown.
# frames, labels and previews need newer fzf releases, older ones keep the plain look.
# menu_header, menu_preview and menu_start (the line the cursor starts on) tune the next menu
# shellcheck disable=SC2086
fzf_menu() {
    _prompt="$1"
    _multi="$2"
    _extra="$3"
    printf "\33[2K\r" >&2
    set -- --ansi --reverse --cycle --delimiter="	" --with-nth=2
    if [ "$fzf_level" -ge 1 ]; then
        set -- "$@" --height="${ANI_CLI_FZF_HEIGHT:-90%}" --border=rounded --info=inline --pointer="▶" --marker="✓" \
            --color="fg+:bold,bg+:-1,hl:5,hl+:5,pointer:5,marker:2,prompt:6,header:4,info:8,border:8,spinner:5"
        [ -n "$menu_header" ] && set -- "$@" --header="$menu_header"
        [ -n "$menu_preview" ] && set -- "$@" --preview="$menu_preview" --preview-window="right:45%:wrap"
        [ "$fzf_gutter" = 1 ] && set -- "$@" --gutter=" "
    fi
    if [ "$fzf_level" -ge 2 ]; then
        # short menus shrink to their content, a later --height wins over the first one
        [ -z "$menu_preview" ] && [ -z "${ANI_CLI_FZF_HEIGHT:-}" ] && set -- "$@" --height="~90%"
        set -- "$@" --prompt="❯ " --border-label=" $_prompt " --border-label-pos=3 --color="label:5:bold"
        [ -n "$menu_start" ] && set -- "$@" --bind="load:pos($menu_start)"
    else
        set -- "$@" --prompt="$_prompt : "
    fi
    fzf "$@" $_multi $_extra
}

fzf_setup() {
    _version="$(fzf --version 2>/dev/null)"
    case "$_version" in
        0.*)
            _minor="${_version#0.}"
            _minor="${_minor%%[!0-9]*}"
            ;;
        [1-9]*) _minor=999 ;;
        *) _minor=0 ;;
    esac
    fzf_level=0
    [ "${_minor:-0}" -ge 29 ] && fzf_level=1
    [ "${_minor:-0}" -ge 36 ] && fzf_level=2
    # recent releases draw a gutter column next to the pointer, it only adds noise here
    fzf_gutter=0
    _status=0
    fzf --gutter=" " --filter="" </dev/null >/dev/null 2>&1 || _status=$?
    [ "$_status" -ne 2 ] && fzf_gutter=1
}

# prints the values of the chosen (value \t label) lines, a lone line is chosen without asking
# $1 = prompt, $2 = multi select flag
choose() {
    _stdin="$(cat -)"
    [ -z "$_stdin" ] && return 1
    _line_count="$(printf "%s\n" "$_stdin" | wc -l | tr -d "[:space:]")"
    [ "$_line_count" -eq 1 ] && printf "%s\n" "$_stdin" | cut -f 1 && return 0
    if [ "$tui" = 1 ]; then
        ui_reset "$1"
        [ -n "$2" ] && ui_multi=1
        [ -n "$menu_preview" ] && ui_pv_cmd="--preview"
        # long lists can be filtered by typing
        [ "$_line_count" -gt 12 ] && ui_input=1
        ui_start="${menu_start:-1}"
        ui_header="$(tui_take_notice)"
        [ -n "$menu_header" ] && ui_header="${ui_header:+$ui_header
}$menu_header"
        _out="$(printf "%s\n" "$_stdin" | ui_menu)"
        case "$_out" in
            @home) kill -USR2 "$$" && return 1 ;;
            @quit) kill -USR1 "$$" && return 1 ;;
            *) ;;
        esac
        [ -n "$_out" ] && printf "%s\n" "$_out" | cut -f 1
        return 0
    fi
    if [ "$menu_program" = "fzf" ]; then
        _out="$(printf "%s\n" "$_stdin" | menu "$1" "$2" "$menu_extra_flags")"
        # the footer buttons of the full screen interface
        case "$_out" in
            @home) kill -USR2 "$$" && return 1 ;;
            @quit) kill -USR1 "$$" && return 1 ;;
            *) ;;
        esac
        [ -n "$_out" ] && printf "%s\n" "$_out" | cut -f 1
        return 0
    fi
    # other menus get the bare labels, the chosen ones are matched back to their line
    _labels="$(printf "%s\n" "$_stdin" | cut -f 2)"
    printf "%s\n" "$_labels" | menu "$1" "$2" "$menu_extra_flags" | while IFS= read -r _label; do
        _n="$(printf "%s\n" "$_labels" | grep -n -F -x -- "$_label" | head -n 1 | cut -d : -f 1)"
        [ -n "$_n" ] && printf "%s\n" "$_stdin" | sed -n "${_n}p" | cut -f 1
    done
}

die() {
    if [ "$tui" = 1 ]; then
        # the message is printed once the full screen is left, from a subshell the main shell is asked to stop
        printf "\033[1;31m✕ %s\033[0m\n" "$*" >>"$tui_dir/fatal"
        kill -USR1 "$$"
        exit 1
    fi
    printf "\33[2K\r\033[1;31m✕ %s\033[0m\n" "$*" >&2
    exit 1
}

info() {
    printf "\33[2K\r\033[1;34m%s\033[0m\n" "$*"
}

# in the full screen interface warnings and notes wait for the header of the next menu
warn() {
    if [ "$tui" = 1 ]; then
        printf "\033[33m! %s\033[0m\n" "$*" >>"$tui_dir/notice"
        return 0
    fi
    printf "\33[2K\r\033[1;33m! %s\033[0m\n" "$*" >&2
}

note() {
    if [ "$tui" = 1 ]; then
        printf "\033[2m%s\033[0m\n" "$*" >>"$tui_dir/notice"
        return 0
    fi
    printf "\33[2K\r\033[2m%s\033[0m\n" "$*" >&2
}

# transient message, the next message or menu replaces it
status() {
    if [ "$tui" = 1 ]; then
        ui_loading_screen "$*"
        return 0
    fi
    printf "\33[2K\r\033[2m%s\033[0m" "$*" >&2
}

banner() {
    printf "\n  \033[1;35mani-cli\033[0;35m-fr\033[0m  \033[2mv%s  ·  animes en VOSTFR et en VF  ·  anime-sama + franime\033[0m\n\n" "$version_number"
}

# name of a version, from the season when the site gives one
lang_label() {
    _found="$(printf "%s" "$lang_list" | sed -n "s|^$1	||p" | head -n 1)"
    [ -n "$_found" ] && printf "%s" "$_found" && return 0
    case "$1" in
        vostfr) printf "VOSTFR" ;;
        vf) printf "VF" ;;
        vf*) printf "VF %s" "${1#vf}" ;;
        *) printf "%s" "$1" ;;
    esac
}

