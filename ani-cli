    esac
}

tui_run() {
    case "$source" in
        history) tui_history && return 0 ;;
        *) [ -n "$query" ] && user_query="$(printf "%s" "$query" | tr '+' ' ')" && tui_search_flow && return 0 ;;
    esac
    while :; do
        user_query=""
        _out="$(tui_home_menu)"
        _choice="${_out%%	*}"
        case "$_choice" in
            search) tui_search_flow && return 0 ;;
            hist:*) tui_resume "${_choice#hist:}" && return 0 ;;
            historique) tui_history && return 0 ;;
            parametres) tui_settings ;;
            aide)
                _after="$(tui_help)"
                [ "$_after" = "@quit" ] && exit 0
                ;;
            @home) ;;
            *) exit 0 ;;
        esac
    done
}

