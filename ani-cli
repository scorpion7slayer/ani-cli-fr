        -c | --continue) source=history ;;
        -d | --download)
            player_function=download
            ;;
        -D | --delete)
            : >"$histfile"
            exit 0
            ;;
        -l | --logview)
            case "$(uname -s)" in
                Darwin*) log show --predicate 'process == "logger"' ;;
                Linux*) journalctl -t ani-cli ;;
                *) die "Logs non disponibles sur votre plateforme" ;;
            esac
            exit 0
            ;;
        -V | --version) version_info ;;
        -h | --help) help_info ;;
        -e | --episode | -r | --range)
            [ $# -lt 2 ] && die "argument manquant !"
            ep_no="$2"
            shift
            ;;
        --vf | --dub) mode="vf" lang_forced=1 ;;
        --vostfr | --sub) mode="vostfr" lang_forced=1 ;;
        --no-detach) no_detach=1 ;;
        --exit-after-play) exit_after_play=1 && no_detach=1 ;;
        --rofi) menu_program=rofi ;;
        --dmenu) menu_program=dmenu ;;
        --skip) skip_intro=1 ;;
        -N | --nextep-countdown) source=nextep ;;
        -U | --update)
            dep_ch "patch"
            branch="${2:-$branch}"
            update_script
            ;;
        *) query="$(printf "%s" "$query $1" | sed 's|^ ||;s| |+|g')" ;;
    esac
    shift
done

case "$mode" in
    sub | vo | vostfr) mode="vostfr" ;;
    dub | vf) mode="vf" ;;
    vf[0-9] | vf[0-9][0-9]) ;;
    *) die "Langue inconnue : $mode (vostfr, vf, vf1, vf2…)" ;;
esac
# an episode given on the command line means a scripted run, nothing is asked about the language
[ -n "$ep_no" ] && lang_forced=1

case "$provider" in
    all) ;;
    as | anime-sama | animesama) provider="animesama" ;;
    fr | franime) provider="franime" ;;
    *) die "Site inconnu : $provider (all, animesama ou franime)" ;;
esac

[ "$menu_program" = "fzf" ] && menu_multi_flag="-m"
[ "$menu_program" = "rofi" ] && menu_multi_flag="-multi-select"

dep_ch "sed"
dep_ch "grep"
[ "$skip_intro" = 1 ] && dep_ch "ani-skip"
dep_ch "$menu_program" # TODO: use dep_ch_failover to iterate through options

case "$player_function" in
    debug) ;;
    download) dep_ch_failover "yt-dlp,ffmpeg" >/dev/null || die 'Ni yt-dlp ni ffmpeg trouvé' ;;
    android*) printf "\33[2K\rLa vérification des lecteurs est désactivée sur Android.\nmpv a besoin de include=\"/storage/emulated/0/mpv/mpv.config.mp4\" dans son mpv.conf, voir le readme.\n" ;;
    *iSH*) printf "\33[2K\rLa vérification des lecteurs est désactivée sur iOS\n" ;;
    *flatpak*mpv*) dep_ch "flatpak" ;;
    *) dep_ch "$player_function" ;;
esac

# idk where to put this, so I put it here...
trap 'cleanup; exit 1' INT HUP TERM

# the history may hold anime-sama entries whatever the provider is
{ [ "$provider" != "franime" ] || [ "$source" = "history" ]; } && as_resolve_domain

if [ "$menu_program" = "fzf" ]; then
    fzf_setup
    set_colors
fi
menu_preview_cmd="sh '$0' --preview {1}"

# the full screen interface unless the run is scripted or the terminal cannot show it
if [ "$menu_program" = "fzf" ] && [ "${ANI_CLI_TUI:-1}" != 0 ] && [ -t 0 ] && [ -t 1 ] && [ -t 2 ] &&
    [ -z "$ep_no" ] && [ -z "$index" ] && [ "$source" != "nextep" ] && [ "$no_detach" = 0 ]; then
    case "$player_function" in
        debug | download) ;;
        *) tui_init "$provider" && tui=1 ;;
    esac
fi

# prints the label of the (value \t label) line of $1 whose value is $2
label_of() {
    printf "%s\n" "$1" | while IFS="	" read -r _value _label _rest; do
        [ "$_value" = "$2" ] && printf "%s\n" "$_label" && break
    done
}

[ "$tui" != 1 ] && [ -t 2 ] && [ "$source" != "nextep" ] && banner >&2

# searching

# the search, the results and the seasons. leaving the season or language menu goes back to the results
search_flow() {
    while :; do
        status "Recherche de « $user_query »…"
        anime_list="$(search_anime "$query")"
        if [ "$exact_match" = 1 ] && [ -n "$anime_list" ]; then
            _query_norm="$(printf "%s" "$user_query" | tr '[:upper:]' '[:lower:]' | tr -s '[:space:]' ' ' | sed 's/^ *//;s/ *$//')"
            anime_list="$(printf "%s\n" "$anime_list" | while IFS="	" read -r _id _title; do
                _title_norm="$(printf "%s" "$_title" | tr '[:upper:]' '[:lower:]' | tr -s '[:space:]' ' ' | sed 's/^ *//;s/ *$//')"
                [ "$_title_norm" = "$_query_norm" ] && printf "%s\t%s\n" "$_id" "$_title"
            done)"
        fi
        if [ -z "$anime_list" ]; then
            _where=""
            [ "$provider" != "all" ] && _where=" sur $(site_label "$provider")"
            warn "Aucun résultat pour « $user_query »$_where"
            menu_header="Aucun résultat pour « $user_query »$_where" menu_preview="" menu_start=""
            _choice="$({
                # the other site is offered once per query
                [ "$_switched" != 1 ] && [ "$provider" = "animesama" ] && printf "franime\t⌕  Chercher sur franime\n"
                [ "$_switched" != 1 ] && [ "$provider" = "franime" ] && printf "animesama\t⌕  Chercher sur anime-sama\n"
                printf "recherche\t❯  Nouvelle recherche\n"
                printf "quitter\t✕  Quitter\n"
            } | choose "Que faire ?")"
            case "$_choice" in
                franime | animesama) provider="$_choice" _switched=1 ;;
                recherche) ask_query "Rechercher un anime" && _switched=0 || return 1 ;;
                *) return 1 ;;
            esac
            continue
        fi
        _single=0
        _count="$(printf "%s\n" "$anime_list" | grep -c '')"
        [ "$_count" -eq 1 ] && _single=1
        while :; do
            _header="$(result_count) pour « $user_query »"
            pick_anime "$_header" || return 1
            pick_season
            _status=$?
            [ "$_status" = 0 ] && return 0
            if [ "$_status" = 1 ]; then
                [ "$_single" = 1 ] && return 1
                continue
            fi
            # nothing to watch here, the other site may have it
            _site="$(other_site)"
            _site="$(site_label "$_site")"
            menu_header="Rien à regarder pour $anime_title" menu_preview="" menu_start=""
            _choice="$({
                printf "site\t⌕  Chercher « %s » sur %s\n" "$base_title" "$_site"
                [ "$_single" = 0 ] && printf "retour\t‹  Revenir aux résultats\n"
                printf "recherche\t❯  Nouvelle recherche\n"
                printf "quitter\t✕  Quitter\n"
            } | choose "Que faire ?")"
            case "$_choice" in
                site) find_on_other_site && return 0 ;;
                retour) ;;
                recherche)
                    ask_query "Rechercher un anime" || return 1
                    break
                    ;;
                *) return 1 ;;
            esac
        done
    done
}

[ "$tui" = 1 ] && backup_old_hist && tui_run
[ "$tui" = 1 ] || case "$source" in
    history)
        backup_old_hist
        status "Lecture de l'historique…"
        anime_list="$(
            while IFS="	" read -r ep_no anime_id anime_title; do
                process_hist_entry &
            done <"$histfile"
            wait
        )"
        [ -z "$anime_list" ] && die "Aucune série en cours dans l'historique !"
        if [ -z "${index##*[!0-9]*}" ]; then
            menu_header="Reprendre une série" menu_preview="$menu_preview_cmd" menu_start=""
            hist_id="$(printf "%s\n" "$anime_list" | choose "Reprendre")"
        else
            hist_id="$(printf "%s\n" "$anime_list" | sed -n "${index}p" | cut -f 1)"
        fi
        [ -z "$hist_id" ] && exit 1
        _entry="$(printf "%s\n" "$anime_list" | while IFS="	" read -r _id _label _next _title; do
            [ "$_id" = "$hist_id" ] && printf "%s\t%s\n" "$_next" "$_title" && break
        done)"
        ep_no="${_entry%%	*}"
        anime_title="${_entry#*	}"
        base_title="${anime_title% - *}"
        hist_split "$hist_id"
        anime_id="$hist_anime"
        case "$anime_id" in
            fr:*) _fr_id="${anime_id#fr:}" && fr_cache_anime "${_fr_id%/*}" ;;
            *) ;;
        esac
        if ! use_language "$hist_lang"; then
            _site="$(site_label "$anime_id")"
            warn "Impossible de récupérer les épisodes de $anime_title sur $_site"
            mode="$hist_lang"
            find_on_other_site || exit 1
        fi
        ;;
    *)
        [ -n "$query" ] || ask_query "Rechercher un anime" || exit 1
        # for checking new releases by specifying anime name
        [ "$source" = "nextep" ] && time_until_next_ep "$query"
        user_query="$(printf "%s" "$query" | tr '+' ' ')"
        query="$(printf "%s" "$query" | sed 's| |+|g')"
        search_flow || exit 1
        ;;
esac
[ -z "$ep_no" ] && ep_no="$(choose_episode)"
if [ -z "$ep_no" ]; then
    [ "$tui" = 1 ] && tui_home
    exit 1
fi

if [ "$tui" != 1 ]; then
    # moves the cursor up one line and clears that line
    tput cuu1 && tput el
    # stores the position of cursor
    tput sc
fi

# playback & loop
playing=1
play_failed=0
if ! play; then
    # without a menu to fall back on, a failure ends the run
    [ "$player_function" = "download" ] || [ "$player_function" = "debug" ] || [ "$exit_after_play" = 1 ] && exit 1
    play_failed=1
fi
[ "$player_function" = "download" ] || [ "$player_function" = "debug" ] && exit 0

while :; do
    cmd="$(playback_menu)"
    case "$cmd" in
        suivant) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") 2>/dev/null ;;
        rejouer) video_link="$replay" ;;
        précédent) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{g;1!p;};h") 2>/dev/null ;;
        choisir)
            _choice="$(choose_episode)"
            [ -z "$_choice" ] && continue
            ep_no="$_choice"
            ;;
        langue)
            _versions="$(lang_count)"
            if [ "$_versions" -gt 2 ]; then
                language_menu "Changer de version" current || continue
            else
                _other="$(other_language)"
                use_language "$_other"
            fi
            # the same episode in the other version when it exists
            if ! printf "%s\n" "$ep_list" | grep -q -x -F -- "$ep_no"; then
                _choice="$(choose_episode)"
                [ -z "$_choice" ] && continue
                ep_no="$_choice"
            fi
            ;;
        lecteur)
            _choice="$(choose_player)"
            [ -z "$_choice" ] && continue
            forced_player="$_choice"
            # the host stays first for the next episodes
            _players="$(list_players "$ep_no")"
            _host_name="$(label_of "$_players" "$_choice")"
            preferred_player="$(printf "%s" "${_host_name%%.*}" | tr '[:upper:]' '[:lower:]')"
            ;;
        qualité)
            menu_header="Qualité actuelle : $current_quality" menu_preview="" menu_start=""
            _choice="$(printf "%s\n" "$links" | sed -n 's|^\([^ >]*\) >.*|\1	\1|p' | choose "Choisir la qualité")"
            [ -z "$_choice" ] && continue
            select_quality "$_choice"
            ;;
        site) find_on_other_site || continue ;;
        accueil) tui_home ;;
        "")
            # escape goes back home in the full screen interface
            [ "$tui" = 1 ] && tui_home
            cleanup
            exit 0
            ;;
        *)
            cleanup
            exit 0
            ;;
    esac
    [ -z "$ep_no" ] && die "Hors limites"
    if play; then
        play_failed=0
    else
        play_failed=1
    fi
done

